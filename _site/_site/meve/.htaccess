RewriteCond %{HTTP_HOST} ^pres.eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.meve.io$
RewriteRule ^BeyondAPCs2020$ "https://www.martineve.com/presentations/2020-BeyondAPCs/" [R=302,L]

RewriteCond %{HTTP_HOST} ^meve.io$ [OR]
RewriteCond %{HTTP_HOST} ^books.eve.gd$ [OR]
RewriteCond %{HTTPS_HOST} ^pres.eve.gd$ [OR]
RewriteCond %{HTTPS_HOST} ^books.eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^pres.eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.meve.io$
RewriteRule ^$ "https://www.martineve.com" [R=302,L]

