.sass-cache
.DS_Store
*.sublime-project
*.sublime-workspace
codekit-config.json
node_modules
_asset_bundler_cache
.jekyll-metadata
.jekyll-cache/
.idea/workspace.xml

# Generated Open Graph image cache (regenerated locally; served copies live in _site)
.og_cache/

# .sequoia-state.json (what Sequoia has published to ATProto) is tracked on
# purpose: the remote build host publishes from a fresh checkout and must
# know what is already live, and its updates come back with the deploy commit.

# Local accessibility worklist — deliberately never committed
ACCESSIBILITY.md

# Build-time PDF edition cache (regenerated locally; served copies live in _site/PDF)
.pdf_cache/

# Generated site output — rebuilt by newdeploy.sh, deployed via rsync
_site/

# env files
.env

__pycache__/

# Last.fm fetch failure sentinel — written by _lastfm/fetch_lastfm.py,
# reported by _plugins/lastfm_check.rb, cleared on the next good fetch
_lastfm/fetch_error.json

# BIROn harvested session cookie (written by ./biron.sh login)
.biron_cookie

# thoughts DB backups (kept local only)
.thoughts-backup-*.yml

# Generated gemtext edition (pushed to smol.pub by _smolpub/sync_smolpub.py)
_smolpub/out/
