Options +FollowSymLinks
RewriteEngine On

# WebFinger for the fediverse: two identities live behind this domain.
# Lookups for acct:blog@eve.gd resolve to the site's own read-only
# ActivityPub actor (actor.jsonld, polled per FEP-b06c); every other
# acct: resource aliases to the personal Mastodon account,
# @mpe@hcommons.social. The resource value may arrive raw or
# percent-encoded, so the condition accepts both forms. Keep these above
# the canonicalisation catch-alls.
RewriteCond %{QUERY_STRING} resource=acct(:|%3[Aa])blog(@|%40)eve\.gd [NC]
RewriteRule ^\.well-known/webfinger$ /.well-known/webfinger-blog [L]
RewriteRule ^\.well-known/webfinger$ - [L]
<FilesMatch "^webfinger(-blog)?$">
ForceType application/jrd+json
</FilesMatch>

# The ActivityPub documents (actor, outbox, posts) must be served with the
# media type fediverse software requests.
<FilesMatch "\.jsonld$">
ForceType application/activity+json
</FilesMatch>

# human.json (https://codeberg.org/robida/human.json), WebFinger and the
# ActivityPub documents are all fetched cross-origin from browsers, so they
# must carry CORS headers.
<IfModule mod_headers.c>
<Files "human.json">
Header set Access-Control-Allow-Origin "*"
</Files>
<FilesMatch "^webfinger(-blog)?$">
Header set Access-Control-Allow-Origin "*"
</FilesMatch>
<FilesMatch "\.jsonld$">
Header set Access-Control-Allow-Origin "*"
</FilesMatch>
</IfModule>

<Limit GET POST>
order deny,allow
deny from all
allow from all
</Limit>
<Limit PUT DELETE>
order deny,allow
deny from all
</Limit>
AuthName eve.gd

RewriteCond %{HTTP_HOST} ^martineve.com$ [OR]
RewriteCond %{HTTP_HOST} ^eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.martineve.com$
RewriteRule ^profile$ "http://www.bbk.ac.uk/english/our-staff/full-time-academic-staff/martin-eve/martin-eve" [R=302,L]
RewriteRule ^profile/(.*)$ "http://www.bbk.ac.uk/english/our-staff/full-time-academic-staff/martin-eve/martin-eve" [R=302,L]

RewriteCond %{HTTP_HOST} ^martineve.com$ [OR]
RewriteCond %{HTTP_HOST} ^eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.martineve.com$
RewriteRule ^2018/02/06/who-was-responsible-for-the-toby-jones-ofs-debacle$ "https://www.martineve.com/2018/02/06/who-was-responsible-for-the-toby-young-ofs-debacle/" [R=302,L]
RewriteRule ^2018/02/06/who-was-responsible-for-the-toby-jones-ofs-debacle/$ "https://www.martineve.com/2018/02/06/who-was-responsible-for-the-toby-young-ofs-debacle/" [R=302,L]

RewriteCond %{HTTP_HOST} ^eve.gd$ [OR]
RewriteCond %{HTTPS_HOST} ^eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.meve.io$
RewriteRule ^sacred$ "http://eprints.bbk.ac.uk/id/eprint/27525" [R=302,L]

RewriteCond %{HTTP_HOST} ^martineve.com$ [OR]
RewriteCond %{HTTP_HOST} ^eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.martineve.com$
RewriteRule ^pynchonphil$ "http://www.palgrave.com/products/title.aspx?pid=753605" [R=302,L]

RewriteCond %{HTTP_HOST} ^martineve.com$ [OR]
RewriteCond %{HTTP_HOST} ^eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.martineve.com$
RewriteRule ^oahums$ "http://www.cambridge.org/9781107484016" [R=302,L]

RewriteCond %{HTTP_HOST} ^martineve.com$ [OR]
RewriteCond %{HTTP_HOST} ^eve.gd$ [OR]
RewriteCond %{HTTP_HOST} ^www.martineve.com$
RewriteRule ^password$ "http://objectsobjectsobjects.com/password/" [R=302,L]

RewriteRule ^wp-content/(.*)$ /images/$1 [R=301,NC,L]

RewriteRule ^feed$ /feed/feed.atom [R=301,NC,L]
RewriteRule ^feed.xml$ /feed/feed.atom [R=301,NC,L]

RewriteCond %{HTTP_HOST} ^martineve\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.martineve\.com$
RewriteRule ^(.*)$ https://eve.gd/$1 [R=301,L]

RewriteCond %{HTTPS_HOST} ^martineve\.com$ [OR]
RewriteCond %{HTTPS_HOST} ^www\.martineve\.com$
RewriteRule ^(.*)$ https://eve.gd/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [NC,R=301,L]
